DirectoryIndex index.php

Options -Indexes

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # No RewriteBase: when omitted, Apache derives it from the physical
    # directory serving the site, which works whether that's the domain
    # root (Hostinger git deploy) or a /gp subfolder (local XAMPP). The
    # hardcoded "RewriteBase /gp/" only matched the local layout, so on
    # Hostinger every rewritten URL (/service/abha-card etc.) 404'd.

    # Clean URLs for Ayushman Help Desk & Smart Cards
    RewriteRule ^ayushman-helpdesk/?$ ayushman-helpdesk.php [L,QSA]
    RewriteRule ^ayushman-card/?$ ayushman-card.php [L,QSA]
    RewriteRule ^verify-id/?$ verify-id.php [L,QSA]

    # SEO-friendly scheme detail URL: /scheme/<slug> -> scheme_details.php?slug=<slug>
    RewriteRule ^scheme/([a-zA-Z0-9-]+)/?$ scheme_details.php?slug=$1 [L,QSA]

    # SEO-friendly citizen service detail URLs: /gp/service/<slug> -> service-detail.php?slug=<slug>
    RewriteRule ^service/([a-zA-Z0-9_-]+)/?$ service-detail.php?slug=$1 [L,QSA]
    RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ service-detail.php?slug=$1 [L,QSA]
    RewriteRule ^service-detail/([a-zA-Z0-9_-]+)/?$ service-detail.php?slug=$1 [L,QSA]
    RewriteRule ^servise-detail/([a-zA-Z0-9_-]+)/?$ service-detail.php?slug=$1 [L,QSA]
    RewriteRule ^services/?$ service.php [L,QSA]
</IfModule>
