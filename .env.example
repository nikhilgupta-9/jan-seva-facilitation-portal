APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/gp

# Subfolder the site lives under (used to build every asset/link URL).
# Local XAMPP: /gp (site is at htdocs/gp/). On a git-deployed host
# (Hostinger etc.) where the repo IS the domain root, leave this EMPTY -
# a non-empty value here that doesn't match the real path is why CSS/JS/
# images all 404 with "Refused to apply style ... MIME type text/html"
# in the browser console (the host's own 404 page gets served instead).
BASE_URL=/gp

DB_HOST=localhost
DB_PORT=3306
DB_NAME=citizen_portal_db
DB_USER=
DB_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CONTACT_RECEIVER_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_MODE=sandbox
DEFAULT_API_FEE=50.00

SMS_GATEWAY_API_KEY=
OTP_TEST_MODE=true
OTP_EXPIRY_MINUTES=10
